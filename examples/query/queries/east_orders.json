{
  "relations": [
    {
      "name": "Order",
      "alias": "o"
    },
    {
      "name": "Customer",
      "alias": "c"
    }
  ],
  "select": [
    {
      "column": "o.c0",
      "name": "order_id"
    },
    {
      "column": "c.c1",
      "name": "region"
    }
  ],
  "where": [
    {
      "eq": [
        "o.c1",
        "c.c0"
      ]
    },
    {
      "eq": [
        "c.c1",
        {
          "type": "text",
          "value": "东区"
        }
      ]
    }
  ]
}
