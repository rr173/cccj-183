{
  "format": "data-quality-policy/1",
  "policy_id": "dq.orders_customers",
  "revision": 1,
  "description": "Order/customer delivery gate: every order must carry a known customer whose region is a known, allowed region; raw source keys must be unique; item rows must reference a known order. Labeled nulls are unknown values, never passes.",
  "sample_limit": 5,
  "indeterminate_fails": false,
  "rules": [
    {"id": "req-customer-region", "kind": "required", "layer": "completed",
     "relation": "Customer", "column": "c1", "severity": "error"},
    {"id": "enum-customer-region", "kind": "enum", "layer": "completed",
     "relation": "Customer", "column": "c1", "severity": "error",
     "allowed": [{"type": "text", "value": "东区"},
                 {"type": "text", "value": "西区"}]},
    {"id": "uniq-order-source-key", "kind": "unique", "layer": "sources",
     "relation": "Order", "columns": ["c0"], "severity": "error"},
    {"id": "ref-order-customer", "kind": "reference", "layer": "sources",
     "relation": "Order", "columns": ["c1"],
     "target": {"relation": "Customer", "columns": ["c0"]},
     "severity": "error"},
    {"id": "ref-order-done-derived", "kind": "reference", "layer": "sources",
     "relation": "Order", "columns": ["c0"],
     "target": {"relation": "Done", "columns": ["c0"]},
     "severity": "info"},
    {"id": "ref-item-order", "kind": "reference", "layer": "sources",
     "relation": "Item", "columns": ["c0"],
     "target": {"relation": "Order", "columns": ["c0"]},
     "severity": "error"},
    {"id": "enum-item-qty", "kind": "enum", "layer": "sources",
     "relation": "Item", "column": "c2", "severity": "warning",
     "allowed": [{"type": "int", "value": 7},
                 {"type": "int", "value": 700},
                 {"type": "int", "value": 42}]}
  ]
}
